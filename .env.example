# Supabase — copy this file to .env.local and fill in the real values.
# Find both under: Supabase dashboard → your project → Project Settings → API
#
# Project URL, looks like https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
#
# The "anon" / "publishable" key. This one is safe to expose in the browser —
# it is protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare Turnstile — the CAPTCHA on sign-up, login and password reset.
# Optional: leave it unset and the forms submit without a challenge.
#
# Site key from: Cloudflare dashboard → Turnstile → your widget. Public by design.
# The matching SECRET key goes in the Supabase dashboard under
# Authentication → Attack Protection → Enable Captcha protection (provider:
# Turnstile), never in this file — Supabase verifies the token server-side.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
