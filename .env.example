# Firebase Auth — copy this file to .env.local and fill in the real values.
#
# Web config, from: Firebase console → Project settings → General → Your apps →
# the web app's "SDK setup and configuration" → Config. Public by design: these
# ship to the browser, and access is controlled by Firebase Auth and its
# authorized-domains list.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Production builds read the four values above from the committed
# .env.production instead.

# Service account — SERVER ONLY. Never prefix these with VITE_ (that would ship
# them to the browser). Used to mint and verify the 14-day session cookie and
# by scripts/migrate-supabase-users.ts. In production these are Cloudflare
# Worker secrets: `npx wrangler secret put FIREBASE_CLIENT_EMAIL` (and
# FIREBASE_PRIVATE_KEY), or Workers → the worker → Settings → Variables and Secrets.
#
# From: Firebase console → Project settings → Service accounts → Generate new
# private key. Copy client_email and private_key out of the downloaded JSON.
# Keep private_key on one line with literal \n escapes, wrapped in quotes.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Google Drive sync (optional) — SERVER ONLY.
# GOOGLE_CLIENT_SECRET: Google Cloud → APIs & Services → Credentials → the web
# OAuth client whose ID is VITE_GOOGLE_CLIENT_ID → Client secret.
# DRIVE_TOKEN_KEY: encrypts each device's Drive grant cookie. Generate with
# `openssl rand -base64 32`. Changing it disconnects Drive on every device.
# In production both are Cloudflare Worker secrets.
GOOGLE_CLIENT_SECRET=
DRIVE_TOKEN_KEY=
